<?xml version="1.0" encoding="utf-8"?>
<!--
  Player page: artwork, then the transport.

  A scrollable column rather than a fixed constraint set, because the control
  block has a real minimum height. Pinned to a non-scrolling parent, a short
  window (split screen, a foldable's inner display) left the cover with no room
  at all - or, with a percentage cap, overlapping the title. Here the flexible
  element is the space between the artwork and the text: it collapses to nothing
  and the page starts scrolling once the controls no longer fit, so the layout
  degrades by scrolling instead of by colliding.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_chevron_right"
            android:rotation="90"
            app:tint="?attr/colorOnSurface" />

        <com.audiocat.ui.common.RoundArtImageView
            android:id="@+id/bigArt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:contentDescription="@string/action_cover"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/art_default"
            app:artKeepSquare="true" />

        <!-- The slack: on a tall phone it pushes the transport down to the thumb,
             and it gives way first when the window shrinks. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:id="@+id/bigTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/now_playing_nothing"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/bigArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/now_playing_unknown_artist"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <SeekBar
            android:id="@+id/bigSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="1000" />

        <LinearLayout
            android:id="@+id/bigPositionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bigPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <TextView
                android:id="@+id/bigDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceLabelMedium" />
        </LinearLayout>

        <!-- Quick controls, parked above the transport for thumb reach -->
        <LinearLayout
            android:id="@+id/quickRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnQueueSheet"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_queue"
                android:src="@drawable/ic_queue"
                app:tint="?attr/colorOnSurfaceVariant" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Speed is the control worth a thumb: it goes on the right, where the
                 hand already is, rather than in the middle of the row. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpeed"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/action_speed"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bigControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bigShuffle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_shuffle"
                android:src="@drawable/ic_shuffle"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/bigPrevious"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_previous"
                android:src="@drawable/ic_previous"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/bigPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_play_disc"
                android:contentDescription="@string/action_play"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/bigNext"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_next"
                android:src="@drawable/ic_next"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/bigRepeat"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_repeat"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
