<?xml version="1.0" encoding="utf-8"?>
<!--
  Play glyph: a rounded triangle whose CENTROID (not bounding box) sits at the
  viewport centre, so it reads optically centred inside a circle. The stroke
  with round joins softens the corners without extra paths.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.5,6.2 L9.5,17.8 L17.4,12 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />
</vector>
